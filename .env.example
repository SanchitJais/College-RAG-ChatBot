# Copy to .env and fill in. Never commit .env.
# Everything here is free. Embeddings run locally (no key). Only the chat model needs a free key.

# --- Chat model: any OpenAI-compatible endpoint. Pick ONE preset. ---

# Preset A (default): Groq free tier. Free key, no credit card: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-free-groq-key
LLM_MODEL=openai/gpt-oss-20b
# Larger alternative: LLM_MODEL=openai/gpt-oss-120b  (check available names: they change; list them with your key at https://api.groq.com/openai/v1/models)

# Preset B: Google Gemini free tier. Key: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.5-flash

# Preset C: local Ollama (fully offline, no account). Install Ollama, then: ollama pull llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1:8b

# --- Retrieval over policy/notice snippets ---
TOP_K=8
# Max cosine distance (0 = identical). Measured on the bundled embedding model; see README.
MAX_DISTANCE=0.65

DATA_DIR=./data

# --- Supabase Postgres (optional; leave empty to use a local SQLite file) ---
# Settings > Database > Connection string. Use the postgresql+psycopg:// scheme.
DATABASE_URL=
